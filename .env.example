# =============================================================
# Crypto Portfolio — Variáveis de Ambiente para Vercel
# =============================================================
# Copie este arquivo para .env.local e preencha os valores.
# Nunca faça commit do .env.local!

# ------- PostgreSQL (obrigatório) -------
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_URL=

# ------- JWT (obrigatório) -------
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=8f4c2e9a1d3b5f76082a4d6e9b1c3f5a7d9e0b2c4a6f8135792468acebdf1357

# ------- Blockchain RPC (opcional — usa RPCs públicos se omitido) -------
ALCHEMY_API_KEY=
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=

# ------- NODE_ENV -------
NODE_ENV=production
