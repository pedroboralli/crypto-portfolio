# Docker Compose Environment Variables
# Copy this file to .env and update with your production values

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=crypto_portfolio
POSTGRES_PORT=5432

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-in-production

# Frontend API URL (Update with your backend URL)
# For local: http://localhost:3000
# For EasyPanel: https://your-backend-app.easypanel.host
VITE_API_URL=http://localhost:3000

# Frontend port (8080 for Windows, 80 for Linux/production)
FRONTEND_PORT=8080
