# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Optional: RPC Provider API Keys (public endpoints used if not provided)
ALCHEMY_API_KEY=your_alchemy_api_key_here
INFURA_API_KEY=your_infura_api_key_here

# Optional: Custom RPC URLs (using reliable Ankr endpoints by default)
ETHEREUM_RPC_URL=https://rpc.ankr.com/eth
ARBITRUM_RPC_URL=https://rpc.ankr.com/arbitrum
POLYGON_RPC_URL=https://rpc.ankr.com/polygon
BNB_RPC_URL=https://rpc.ankr.com/bsc

# Cache Configuration (in seconds)
CACHE_TTL=60
